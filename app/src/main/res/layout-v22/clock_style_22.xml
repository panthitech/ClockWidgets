<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_date_time_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorWidgetBackground"
        android:orientation="horizontal"
        android:weightSum="6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="2.2" />

        <LinearLayout
            android:id="@+id/widget_date_time_background_color"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:background="@color/colorRed"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="2.2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="10">

        <TextClock
            android:id="@+id/widget_day"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="-10dp"
            android:layout_weight="7"
            android:autoSizeMinTextSize="2sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/sacramento_regular"
            android:gravity="bottom|center_vertical|center_horizontal|center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Monday"
            android:format12Hour="cccc"
            android:format24Hour="cccc"
            android:textColor="@color/colorYellow"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="horizontal"
            android:weightSum="6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="2.2" />

            <LinearLayout
                android:id="@+id/widget_time_control"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:gravity="center"
                android:orientation="vertical"
                android:weightSum="10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="8"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:weightSum="20">

                    <TextClock
                        android:id="@+id/widget_time_hours"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="5.5"
                        android:autoSizeMaxTextSize="300sp"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/open_sans_regular"
                        android:gravity="right|center_vertical|center_horizontal|center|end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="08"
                        android:format12Hour="hh"
                        android:format24Hour="HH"
                        android:textColor="@color/colorWhite"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_time_delimiter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="9"
                        android:autoSizeMaxTextSize="300sp"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/open_sans_regular"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:paddingBottom="4dp"
                        android:text=" :"
                        android:textColor="@color/colorYellow"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="visible" />

                    <TextClock
                        android:id="@+id/widget_time_minute"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="0dp"
                        android:layout_weight="5.5"
                        android:autoSizeMaxTextSize="300sp"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/open_sans_regular"
                        android:gravity="left|center_vertical|center_horizontal|center|start"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="45"
                        android:format12Hour="mm"
                        android:format24Hour="mm"
                        android:textColor="@color/colorYellow"
                        android:textSize="25sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextClock
                    android:id="@+id/widget_time_am_pm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="300sp"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/syncopate_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=" PM"
                    android:format12Hour=" aa"
                    android:format24Hour=" aa"
                    android:textColor="@color/colorWhite"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextClock
                    android:id="@+id/widget_date"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:layout_weight="2"
                    android:autoSizeMinTextSize="2sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/open_sans_regular"
                    android:gravity="top|center_vertical|center_horizontal|center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="5 Jan"
                    android:format12Hour="dd MMM"
                    android:format24Hour="dd MMM"
                    android:textColor="@color/colorWhite"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="2.2" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
