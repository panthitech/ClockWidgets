<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/widget_date_time_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorWidgetBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:weightSum="2">

            <TextClock
                android:id="@+id/widget_day"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:layout_weight="3"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="left|center_vertical|center_horizontal|center|start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Saturday"
                android:format12Hour="cccc"
                android:format24Hour="cccc"
                android:textColor="@color/colorWhite"
                android:textSize="25sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.7"
                android:orientation="horizontal"
                android:weightSum="5">

                <LinearLayout
                    android:id="@+id/widget_time_control"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1.6"
                    android:gravity="left|center_vertical|center_horizontal|center|start"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextClock
                        android:id="@+id/widget_time_hours"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="300sp"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="bottom|center_vertical|center_horizontal|center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="08"
                        android:format12Hour="hh"
                        android:format24Hour="HH"
                        android:textColor="@color/colorWhite"
                        android:textSize="50sp" />

                    <TextView
                        android:id="@+id/widget_time_delimiter"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:autoSizeMaxTextSize="300sp"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="bottom|center_vertical|center_horizontal|center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:paddingStart="5dp"
                        android:paddingBottom="2dp"
                        android:text=":"
                        android:textColor="@color/colorWhite"
                        android:textSize="40sp" />

                    <TextClock
                        android:id="@+id/widget_time_minute"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="300sp"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="bottom|center_vertical|center_horizontal|center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="08"
                        android:format12Hour="mm"
                        android:format24Hour="mm"
                        android:textColor="@color/colorWhite"
                        android:textSize="50sp" />

                    <TextClock
                        android:id="@+id/widget_time_am_pm"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:autoSizeMaxTextSize="300sp"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="left|center_vertical|center_horizontal|center|start"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:paddingVertical="8dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text=" PM"
                        android:format12Hour=" aa"
                        android:format24Hour=" aa"
                        android:textAllCaps="true"
                        android:textColor="@color/colorWhite"
                        android:textSize="20sp"
                        android:textStyle="normal"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="3.4" />
            </LinearLayout>

            <TextClock
                android:id="@+id/widget_date"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="0dp"
                android:layout_weight="1.3"
                android:autoSizeMaxTextSize="100sp"
                android:autoSizeMinTextSize="2sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="top|left|center_vertical|center_horizontal|center|start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Friday, Jan 5"
                android:format12Hour="cccc, MMM d"
                android:format24Hour="cccc, MMM d"
                android:textColor="@color/colorWhite"
                android:textSize="50sp"
                android:textStyle="normal" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
