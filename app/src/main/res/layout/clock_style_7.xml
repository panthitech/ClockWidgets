<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/widget_date_time_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorWidgetBackground"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="-40dp"
            android:layout_marginBottom="-5dp"
            android:layout_weight="2"
            android:fontFamily="@font/sarala_regular"
            android:gravity="bottom|center_vertical|center_horizontal|center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="5 Jan"
            android:format12Hour="dd MMMM"
            android:format24Hour="dd MMMM"
            android:textColor="@color/colorWhite"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="-5dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/widget_time_hours"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/lexend_mega_regular"
                android:gravity="right|center_vertical|center_horizontal|center|end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:text="08"
                android:textColor="@color/colorWhite"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_time_delimiter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lexend_mega_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="."
                android:textColor="@color/colorYellow"
                android:textSize="40sp" />

            <TextClock
                android:id="@+id/widget_time_minute"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/lexend_mega_regular"
                android:gravity="left|center_vertical|center_horizontal|center|start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="45"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:textColor="@color/colorYellow"
                android:textSize="40sp" />

            <TextClock
                android:id="@+id/widget_time_am_pm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:fontFamily="@font/sarala_regular"
                android:gravity="left|center_vertical|center_horizontal|center|start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text=" PM"
                android:format12Hour=" aa"
                android:format24Hour=" aa"
                android:textColor="@color/colorWhite"
                android:textSize="20sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextClock
            android:id="@+id/widget_day"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-5dp"
            android:layout_weight="2"
            android:fontFamily="@font/sarala_regular"
            android:gravity="top|right|center_vertical|center_horizontal|center|end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingEnd="15dp"
            android:text="Monday"
            android:format12Hour="cccc"
            android:format24Hour="cccc"
            android:textColor="@color/colorYellow"
            android:textSize="10sp" />
    </LinearLayout>
</RelativeLayout>
