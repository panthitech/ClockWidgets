<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/widget_date_time_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorWidgetBackground"
        android:orientation="horizontal"
        android:weightSum="100">

        <TextClock
            android:id="@+id/widget_time_hours"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="23"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="08"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:textColor="@color/colorWhite"
            android:textSize="35sp" />

        <TextView
            android:id="@+id/widget_time_delimiter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="31"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=":"
            android:textColor="@color/colorWhite"
            android:textSize="45sp" />

        <TextClock
            android:id="@+id/widget_time_minute"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="23"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="45"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:textColor="@color/colorWhite"
            android:textSize="35sp" />

        <TextClock
            android:id="@+id/widget_time_am_pm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="23"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=" PM"
            android:format12Hour=" aa"
            android:format24Hour=" aa"
            android:textAllCaps="true"
            android:textColor="@color/colorWhite"
            android:textSize="20sp"
            android:visibility="visible" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/widget_date_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:visibility="gone">

        <TextClock
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMinTextSize="2sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="MONDAY"
            android:textColor="#ffc107"
            android:textSize="10sp" />

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/widget_day"
            android:autoSizeMinTextSize="2sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="5 JAN 2021"
            android:textColor="@color/colorWhite"
            android:textSize="10sp" />
    </RelativeLayout>
</RelativeLayout>
